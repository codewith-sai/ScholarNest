generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
}
enum Role {
 STUDENT
 ADMIN
}
enum ApplicationStatus {
 SAVED
 PLANNING
 APPLIED
 UNDER_REVIEW
 SELECTED
 REJECTED
}
model User {
 id Int @id @default(autoincrement())
 name String
 email String @unique
 passwordHash String
 role Role @default(STUDENT)
 enabled Boolean @default(true)
 profile StudentProfile?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model StudentProfile {
 id Int @id @default(autoincrement())
 userId Int @unique
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 dateOfBirth DateTime?
 gender String?
 state String?
 district String?
 city String?
 category String?
 caste String?
 minorityStatus Boolean @default(false)
 disabilityStatus Boolean @default(false)
 annualIncome Float?
 incomeCertificate Boolean @default(false)
 occupation String?
 educationLevel String?
 college String?
 course String?
 branch String?
 academicYear Int?
 percentage Float?
 cgpa Float?
 domicileState String?
 rural Boolean?
 profileCompleted Boolean @default(false)
 saved SavedScholarship[]
 applications ApplicationTracking[]
 notifications Notification[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model Scholarship {
 id Int @id @default(autoincrement())
 name String
 provider String
 description String @db.Text
 scholarshipType String
 benefits String @db.Text
 amount Float?
 openingDate DateTime?
 deadline DateTime?
 applicationUrl String?
 applicationInstructions String? @db.Text
 active Boolean @default(true)
 isDemo Boolean @default(true)
 eligibility ScholarshipEligibility[]
 documents ScholarshipDocument[]
 saved SavedScholarship[]
 applications ApplicationTracking[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([active,deadline])
}
model ScholarshipEligibility {
 id Int @id @default(autoincrement())
 scholarshipId Int
 scholarship Scholarship @relation(fields:[scholarshipId],references:[id],onDelete:Cascade)
 field String
 operator String @default("IN")
 values Json?
 minValue Float?
 maxValue Float?
 required Boolean @default(true)
 label String?
 @@index([scholarshipId,field])
}
model ScholarshipDocument {
 id Int @id @default(autoincrement())
 scholarshipId Int
 scholarship Scholarship @relation(fields:[scholarshipId],references:[id],onDelete:Cascade)
 documentName String
}
model SavedScholarship {
 id Int @id @default(autoincrement())
 studentId Int
 scholarshipId Int
 student StudentProfile @relation(fields:[studentId],references:[id],onDelete:Cascade)
 scholarship Scholarship @relation(fields:[scholarshipId],references:[id],onDelete:Cascade)
 createdAt DateTime @default(now())
 @@unique([studentId,scholarshipId])
}
model ApplicationTracking {
 id Int @id @default(autoincrement())
 studentId Int
 scholarshipId Int
 status ApplicationStatus @default(SAVED)
 appliedAt DateTime?
 student StudentProfile @relation(fields:[studentId],references:[id],onDelete:Cascade)
 scholarship Scholarship @relation(fields:[scholarshipId],references:[id],onDelete:Cascade)
 updatedAt DateTime @updatedAt
 @@unique([studentId,scholarshipId])
}
model Notification {
 id Int @id @default(autoincrement())
 studentId Int
 student StudentProfile @relation(fields:[studentId],references:[id],onDelete:Cascade)
 title String
 message String @db.Text
 type String
 read Boolean @default(false)
 createdAt DateTime @default(now())
 @@index([studentId,read])
}
